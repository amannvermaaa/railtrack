# Server Configuration
PORT=5000

# Railway API Provider Configuration
# Supported providers: rapidapi-irctc, railkit, rapidapi, railradar
RAILWAY_PROVIDER=railradar

# Your RailRadar API Key (Get it from railradar.in)
RAILWAY_API_KEY=your_secret_api_key_here

# API URL for RailRadar
RAILWAY_API_URL=https://api.railradar.in/v1

